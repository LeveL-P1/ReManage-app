            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "resident",
                "guard"
              ]
            }
          },
          "activeRole": {
            "type": "string",
            "enum": [
              "resident",
              "guard"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featureFlags": {
            "$ref": "#/components/schemas/MobileFeatureFlagsDto"
          },
          "notificationPolicy": {
            "$ref": "#/components/schemas/MobileNotificationPolicyDto"
          }
        },
        "required": [
          "user",
          "society",
          "approvedRoles",
          "activeRole",
          "permissions",
          "featureFlags",
          "notificationPolicy"
        ]
      },
      "MobileBootstrapSocietyDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MobileBootstrapUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      },
      "MobileCommunityNotificationPolicyDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "configurable": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "enabled",
          "configurable"
        ]
      },
      "MobileCriticalNotificationPolicyDto": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "configurable": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "enabled",
          "configurable"
        ]
      },
      "MobileFeatureFlagsDto": {
        "type": "object",
        "properties": {
          "residentShell": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "guardShell": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "nativePush": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "guardOffline": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "residentShell",
          "guardShell",
          "nativePush",
          "guardOffline"
        ]
      },
      "MobileGuardOverviewCountsDto": {
        "type": "object",
        "properties": {
          "inside": {
            "type": "number"
          },
          "expected": {
            "type": "number"
          },
          "pendingApproval": {
            "type": "number"
          },
          "pendingParcels": {
            "type": "number"
          }
        },
        "required": [
          "inside",
          "expected",
          "pendingApproval",
          "pendingParcels"
        ]
      },
      "MobileGuardOverviewDto": {
        "type": "object",
        "properties": {
          "gateLabel": {
            "type": "string"
          },
          "counts": {
            "$ref": "#/components/schemas/MobileGuardOverviewCountsDto"
          }
        },
        "required": [
          "gateLabel",
          "counts"
        ]
      },
      "MobileGuardPasscodeResultDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passcodeVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "passcodeVerified"
        ]
      },
      "MobileGuardProblemDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "flat_not_found",
              "visitor_not_found",
              "visitor_not_approved",
              "visitor_not_inside",
              "visitor_blacklisted",
              "invalid_visitor_passcode",
              "passcode_verification_required"
            ]
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "MobileGuardVisitorDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "flatNumber": {
            "type": "string"
          },
          "visitorName": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "expected",
              "inside",
              "exited",
              "rejected",
              "cancelled"
            ]
