            "type": "string"
          },
          "vehicleNo": {
            "nullable": true,
            "type": "string"
          },
          "visitorName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "visitorName",
          "purpose",
          "status",
          "createdAt"
        ],
        "type": "object"
      },
      "MobileResidentVisitorsDto": {
        "properties": {
          "flatNumber": {
            "nullable": true,
            "type": "string"
          },
          "visitors": {
            "items": {
              "$ref": "#/components/schemas/MobileResidentVisitorDto"
            },
            "type": "array"
          }
        },
        "required": [
          "visitors"
        ],
        "type": "object"
      },
