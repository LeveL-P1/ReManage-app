        "required": [
          "accessToken",
          "accessExpiresAt",
          "renewableCredential",
          "renewableExpiresAt",
          "deviceSessionId",
          "activeRole"
        ],
        "type": "object"
      },
      "MobileTransactionalNotificationPolicyDto": {
        "properties": {
          "configurable": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "enabled": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "configurable"
        ],
        "type": "object"
      },
      "OtpRequestAcceptedDto": {
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "challengeId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "accepted",
          "challengeId"
        ],
        "type": "object"
      },
      "OtpRequestDto": {
        "properties": {
          "identifier": {
            "format": "email",
            "type": "string"
          },
          "installation": {
            "$ref": "#/components/schemas/MobileInstallationDto"
          }
        },
        "required": [
          "identifier",
          "installation"
        ],
        "type": "object"
      },
      "OtpVerifyDto": {
        "properties": {
          "challengeId": {
            "format": "uuid",
            "type": "string"
          },
          "code": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "installation": {
            "$ref": "#/components/schemas/MobileInstallationDto"
          }
        },
        "required": [
          "challengeId",
          "code",
          "installation"
        ],
        "type": "object"
      },
      "PasswordLoginRequestDto": {
        "properties": {
          "identifier": {
            "format": "email",
            "type": "string"
          },
          "installation": {
            "$ref": "#/components/schemas/MobileInstallationDto"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "password",
          "installation"
        ],
        "type": "object"
      },
      "RefreshMobileSessionDto": {
        "properties": {
          "renewableCredential": {
            "type": "string"
          }
        },
        "required": [
          "renewableCredential"
        ],
        "type": "object"
      },
      "RequestVisitorDto": {
        "properties": {
          "flatQuery": {
            "example": "A-308",
            "type": "string"
          },
          "passcode": {
            "example": "4829",
            "type": "string"
          },
          "phone": {
            "example": "+919876543210",
            "type": "string"
          },
          "purpose": {
            "example": "guest",
            "type": "string"
          },
          "vehicleNo": {
            "example": "MH 12 AB 1234",
            "type": "string"
          },
          "visitorName": {
            "example": "Maya",
            "type": "string"
          }
        },
        "required": [
          "flatQuery",
          "visitorName",
          "purpose"
        ],
        "type": "object"
      },
      "UpdateMobileActiveRoleDto": {
        "properties": {
          "role": {
            "enum": [
              "resident",
              "guard"
            ],
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "type": "object"
      },
      "VerifyVisitorPasscodeDto": {
        "properties": {
          "passcode": {
            "example": "4829",
            "type": "string"
          }
        },
        "required": [
          "passcode"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
