        "type": "object"
      },
      "LogoutMobileSessionResponseDto": {
        "properties": {
          "loggedOut": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "loggedOut"
        ],
        "type": "object"
      },
      "MobileBootstrapDto": {
        "properties": {
          "activeRole": {
            "enum": [
              "resident",
              "guard"
            ],
            "type": "string"
          },
          "approvedRoles": {
            "items": {
              "enum": [
                "resident",
                "guard"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "featureFlags": {
            "$ref": "#/components/schemas/MobileFeatureFlagsDto"
          },
          "notificationPolicy": {
            "$ref": "#/components/schemas/MobileNotificationPolicyDto"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "society": {
            "$ref": "#/components/schemas/MobileBootstrapSocietyDto"
          },
          "user": {
            "$ref": "#/components/schemas/MobileBootstrapUserDto"
          }
        },
        "required": [
          "user",
          "society",
          "approvedRoles",
          "activeRole",
          "permissions",
          "featureFlags",
          "notificationPolicy"
        ],
        "type": "object"
      },
      "MobileBootstrapSocietyDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "MobileBootstrapUserDto": {
        "properties": {
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "type": "object"
      },
      "MobileCommunityNotificationPolicyDto": {
        "properties": {
          "configurable": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "enabled": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "configurable"
        ],
        "type": "object"
      },
      "MobileCriticalNotificationPolicyDto": {
        "properties": {
          "configurable": {
            "enum": [
              false
            ],
            "type": "boolean"
          },
          "enabled": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "configurable"
        ],
        "type": "object"
      },
      "MobileFeatureFlagsDto": {
        "properties": {
          "guardOffline": {
            "enum": [
              false
            ],
            "type": "boolean"
          },
          "guardShell": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "nativePush": {
            "enum": [
              false
            ],
            "type": "boolean"
          },
          "residentShell": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "residentShell",
          "guardShell",
          "nativePush",
          "guardOffline"
        ],
        "type": "object"
      },
      "MobileGuardOverviewCountsDto": {
        "properties": {
          "expected": {
            "type": "number"
          },
          "inside": {
            "type": "number"
          },
          "pendingApproval": {
            "type": "number"
          },
          "pendingParcels": {
            "type": "number"
          }
        },
        "required": [
          "inside",
          "expected",
          "pendingApproval",
          "pendingParcels"
        ],
        "type": "object"
      },
      "MobileGuardOverviewDto": {
        "properties": {
          "counts": {
            "$ref": "#/components/schemas/MobileGuardOverviewCountsDto"
          },
          "gateLabel": {
            "type": "string"
          }
        },
        "required": [
          "gateLabel",
          "counts"
        ],
        "type": "object"
      },
      "MobileGuardPasscodeResultDto": {
        "properties": {
          "id": {
            "type": "string"
          },
          "passcodeVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "passcodeVerified"
        ],
        "type": "object"
      },
      "MobileGuardProblemDto": {
        "properties": {
          "code": {
            "enum": [
              "flat_not_found",
              "visitor_not_found",
              "visitor_not_approved",
              "visitor_not_inside",
              "visitor_blacklisted",
              "invalid_visitor_passcode",
              "passcode_verification_required"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "MobileGuardVisitorDto": {
        "properties": {
          "arrivedAt": {
            "type": "string"
          },
          "entryTime": {
            "nullable": true,
            "type": "string"
          },
          "exitTime": {
            "nullable": true,
            "type": "string"
          },
          "flatNumber": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "passcodeRequired": {
            "description": "Whether the visitor must verify a stored passcode before check-in.",
            "type": "boolean"
          },
          "phone": {
            "nullable": true,
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "residentResponse": {
            "nullable": true,
            "type": "string"
          },
          "status": {
            "enum": [
              "expected",
              "inside",
              "exited",
              "rejected",
              "cancelled"
            ],
            "type": "string"
          },
          "vehicleNo": {
            "nullable": true,
            "type": "string"
          },
          "visitorName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "flatNumber",
          "visitorName",
          "purpose",
          "status",
          "passcodeRequired",
          "arrivedAt"
        ],
        "type": "object"
      },
      "MobileInstallationDto": {
        "properties": {
          "appVersion": {
            "example": "1.0.0",
            "type": "string"
          },
          "deviceName": {
            "example": "Pixel 9",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "platform": {
            "enum": [
              "android",
              "ios"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "platform",
          "appVersion"
        ],
        "type": "object"
      },
      "MobileNotificationPolicyDto": {
        "properties": {
          "community": {
            "$ref": "#/components/schemas/MobileCommunityNotificationPolicyDto"
          },
          "critical": {
            "$ref": "#/components/schemas/MobileCriticalNotificationPolicyDto"
          },
          "transactional": {
            "$ref": "#/components/schemas/MobileTransactionalNotificationPolicyDto"
          }
        },
        "required": [
          "critical",
          "transactional",
          "community"
        ],
        "type": "object"
      },
      "MobileResidentProblemDto": {
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "MobileResidentVisitorDto": {
        "properties": {
          "arrivedAt": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "entryTime": {
            "nullable": true,
            "type": "string"
          },
          "exitTime": {
            "nullable": true,
            "type": "string"
          },
          "expectedAt": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "passcode": {
            "nullable": true,
            "type": "string"
          },
          "phone": {
            "nullable": true,
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "approved",
              "inside",
              "exited",
              "rejected",
              "cancelled"
